    "import torch\n",
    "\n",
    "x = torch.tensor([1.0], requires_grad=True)\n",
    "z = torch.tensor([2.0], requires_grad=True)\n",
    "\n",
    "h1 = x * z\n",
    "h2 = h1**2\n",
    "y = torch.sin(h2)\n",
    "\n",
    "y.backward()\n",
    "\n",
    "print(x.grad)\n",
    "print(z.grad)\n",
    "print(h1.grad)"
   ]
